<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         BeamShare — Light Theme
         Place in: res/values/themes.xml
         ============================================================ -->

    <!-- Base application theme -->
    <style name="Theme.BeamShare" parent="Theme.Material3.Light.NoActionBar">

        <!-- Brand colors -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_light</item>
        <item name="colorOnPrimary">@color/color_white</item>
        <item name="colorOnPrimaryContainer">@color/color_primary_dark</item>

        <item name="colorSecondary">@color/color_primary</item>
        <item name="colorSecondaryContainer">@color/color_primary_tint</item>
        <item name="colorOnSecondary">@color/color_white</item>
        <item name="colorOnSecondaryContainer">@color/color_primary</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_elevated</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/color_text_secondary</item>

        <!-- Error -->
        <item name="colorError">@color/color_red</item>
        <item name="colorOnError">@color/color_white</item>
        <item name="colorErrorContainer">@color/color_red_tint</item>

        <!-- Outline / Divider -->
        <item name="colorOutline">@color/color_border</item>
        <item name="colorOutlineVariant">@color/color_divider</item>


        <!-- Window -->
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:windowActivityTransitions">true</item>

        <!-- Ripple -->
        <item name="colorControlHighlight">@color/color_ripple</item>

        <!-- Text appearance overrides (Inter font) -->
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>

        <!-- Material component styles -->
        <item name="materialButtonStyle">@style/Widget.BeamShare.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.BeamShare.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.BeamShare.TextInput</item>
        <item name="bottomNavigationStyle">@style/Widget.BeamShare.BottomNav</item>
        <item name="appBarLayoutStyle">@style/Widget.BeamShare.AppBarLayout</item>
        <item name="toolbarStyle">@style/Widget.BeamShare.Toolbar</item>
        <item name="chipStyle">@style/Widget.BeamShare.Chip</item>
        <item name="materialCardViewStyle">@style/Widget.BeamShare.Card</item>
        <item name="bottomSheetDialogTheme">@style/Theme.BeamShare.BottomSheet</item>
        <item name="snackbarStyle">@style/Widget.BeamShare.Snackbar</item>
        <item name="switchStyle">@style/Widget.BeamShare.Switch</item>
    </style>


    <!-- ====================  TEXT STYLES  ==================== -->

    <!-- Screen titles — 24sp Bold -->
    <style name="TextAppearance.BeamShare.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <!-- Section headers — 18sp SemiBold -->
    <style name="TextAppearance.BeamShare.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <!-- Card titles / list items — 16sp SemiBold -->
    <style name="TextAppearance.BeamShare.Subtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <!-- Body text — 14sp Regular -->
    <style name="TextAppearance.BeamShare.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <!-- Secondary / caption — 12sp Regular -->
    <style name="TextAppearance.BeamShare.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <!-- Label / overline — 11sp Medium CAPS -->
    <style name="TextAppearance.BeamShare.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/color_text_tertiary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Button text — 16sp SemiBold -->
    <style name="TextAppearance.BeamShare.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
    </style>


    <!-- ====================  BUTTON STYLES  ==================== -->

    <!-- Primary filled button (Send / Receive) -->
    <style name="Widget.BeamShare.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/color_white</item>
        <item name="rippleColor">@color/color_ripple</item>
        <item name="iconTint">@color/color_white</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- Outlined button -->
    <style name="Widget.BeamShare.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="rippleColor">@color/color_primary_tint</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- Text button (Cancel, Skip) -->
    <style name="Widget.BeamShare.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="rippleColor">@color/color_primary_tint</item>
    </style>

    <!-- Icon-only button (Back, Close) -->
    <style name="Widget.BeamShare.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/color_text_primary</item>
        <item name="rippleColor">@color/color_ripple</item>
    </style>


    <!-- ====================  CARD STYLE  ==================== -->

    <style name="Widget.BeamShare.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Elevated card (Send/Receive action cards) -->
    <style name="Widget.BeamShare.Card.Action" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/color_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">20dp</item>
    </style>


    <!-- ====================  INPUT FIELDS  ==================== -->

    <style name="Widget.BeamShare.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/selector_text_input_stroke</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="hintTextColor">@color/color_text_secondary</item>
        <item name="android:textColorHint">@color/color_text_tertiary</item>
    </style>


    <!-- ====================  BOTTOM NAVIGATION  ==================== -->

    <style name="Widget.BeamShare.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/color_surface</item>
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.BeamShare.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:minHeight">64dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.BeamShare.BottomNav.Active
        </item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.BeamShare.BottomNav.Inactive
        </item>
    </style>

    <style name="Widget.BeamShare.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color_primary_tint</item>
        <item name="shapeAppearance">@style/ShapeAppearance.BeamShare.Pill</item>
    </style>

    <style name="TextAppearance.BeamShare.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.BeamShare.BottomNav.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
    </style>


    <!-- ====================  APP BAR / TOOLBAR  ==================== -->

    <style name="Widget.BeamShare.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">@color/color_background</item>
        <item name="liftOnScroll">false</item>
    </style>

    <style name="Widget.BeamShare.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/color_background</item>
        <item name="titleTextAppearance">@style/TextAppearance.BeamShare.Headline</item>
        <item name="navigationIconTint">@color/color_text_primary</item>
        <item name="android:minHeight">56dp</item>
    </style>


    <!-- ====================  CHIPS  ==================== -->

    <style name="Widget.BeamShare.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">13sp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipBackgroundColor">@color/selector_chip_bg</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/selector_chip_text</item>
    </style>

    <!-- Category chip (Images, Videos, etc.) -->
    <style name="Widget.BeamShare.Chip.Category" parent="Widget.Material3.Chip.Assist">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipBackgroundColor">@color/color_surface_elevated</item>
        <item name="chipIconSize">18dp</item>
    </style>


    <!-- ====================  DIALOG  ==================== -->

    <style name="Theme.BeamShare.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.BeamShare.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.BeamShare.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.BeamShare.Button.Text</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BeamShare.Dialog</item>
    </style>

    <style name="Widget.BeamShare.Button.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/color_primary</item>
    </style>

    <style name="ShapeAppearance.BeamShare.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>


    <!-- ====================  SNACKBAR  ==================== -->

    <style name="Widget.BeamShare.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="android:layout_margin">16dp</item>
    </style>

    <style name="Widget.BeamShare.Snackbar.Text" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
    </style>


    <!-- ====================  SWITCH / TOGGLE  ==================== -->

    <style name="Widget.BeamShare.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/selector_switch_thumb</item>
        <item name="trackTint">@color/selector_switch_track</item>
    </style>


    <!-- ====================  PROGRESS  ==================== -->

    <style name="Widget.BeamShare.ProgressBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/color_primary</item>
        <item name="trackColor">@color/color_progress_track</item>
        <item name="trackCornerRadius">4dp</item>
        <item name="trackThickness">8dp</item>
    </style>

    <style name="Widget.BeamShare.ProgressBar.Circular" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/color_primary</item>
        <item name="trackColor">@color/color_progress_track</item>
        <item name="trackThickness">4dp</item>
    </style>


    <!-- ====================  SHAPES  ==================== -->

    <style name="ShapeAppearance.BeamShare.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.BeamShare.RoundedSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.BeamShare.RoundedMedium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.BeamShare.RoundedLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.BeamShare.RoundedXLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>


    <!-- ====================  SPLASH SCREEN  ==================== -->

    <style name="Theme.BeamShare.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/color_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.BeamShare</item>
    </style>

    <style name="Theme.BeamShare.BottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.BeamShare.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Widget.BeamShare.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BeamShare.BottomSheet</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.BeamShare.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <!-- Base application theme. -->
    <style name="Base.Theme.BeamShare" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

</resources>