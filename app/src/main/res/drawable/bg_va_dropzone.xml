<?xml version="1.0" encoding="utf-8"?>
<!-- Drop zone: dashed border + dark translucent fill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/va_surface" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <!--
          Android's XML doesn't support true dashed strokes on rounded rectangles
          (dashWidth/dashGap only work on straight shapes without rounded corners).
          Use a thin solid stroke here; for a true dashed effect draw it
          programmatically in the fragment with a DashedBorderDrawable or a
          custom Canvas drawing approach.
        -->
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/va_border"
                android:dashWidth="6dp"
                android:dashGap="4dp" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
