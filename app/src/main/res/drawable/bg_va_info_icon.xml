<?xml version="1.0" encoding="utf-8"?>
<!-- Info icon background (VA02 MP3 format info row): accent glow fill + accent stroke -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/va_accent_glow" />
    <stroke
        android:width="1dp"
        android:color="@color/va_accent" />
    <corners android:radius="10dp" />
</shape>
