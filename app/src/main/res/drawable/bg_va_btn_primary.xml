<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient button: blue → purple (matches BeamShare accent colors) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/bs_blue"
        android:endColor="@color/bs_teal"
        android:type="linear" />
    <corners android:radius="14dp" />
</shape>
