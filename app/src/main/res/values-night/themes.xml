<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         BeamShare — Dark Theme
         Place in: res/values-night/themes.xml
         ============================================================ -->

    <style name="Theme.BeamShare" parent="Theme.Material3.Dark.NoActionBar">

        <!-- Brand colors -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_dark</item>
        <item name="colorOnPrimary">@color/color_white</item>
        <item name="colorOnPrimaryContainer">@color/color_primary_light</item>

        <item name="colorSecondary">@color/color_primary</item>
        <item name="colorSecondaryContainer">@color/color_primary_tint</item>
        <item name="colorOnSecondary">@color/color_white</item>
        <item name="colorOnSecondaryContainer">@color/color_primary</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorSurfaceVariant">@color/color_surface_elevated</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/color_text_secondary</item>

        <!-- Error -->
        <item name="colorError">@color/color_red</item>
        <item name="colorOnError">@color/color_white</item>
        <item name="colorErrorContainer">@color/color_red_tint</item>

        <!-- Outline / Divider -->
        <item name="colorOutline">@color/color_border</item>
        <item name="colorOutlineVariant">@color/color_divider</item>

        <!-- Status bar & Navigation bar (dark) -->
        <item name="android:statusBarColor">@color/color_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/color_surface</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:windowActivityTransitions">true</item>

        <!-- Ripple -->
        <item name="colorControlHighlight">@color/color_ripple</item>

        <!-- Font -->
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>

        <!-- Component styles (same names, dark colors auto-applied via colors-night) -->
        <item name="materialButtonStyle">@style/Widget.BeamShare.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.BeamShare.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.BeamShare.TextInput</item>
        <item name="bottomNavigationStyle">@style/Widget.BeamShare.BottomNav</item>
        <item name="appBarLayoutStyle">@style/Widget.BeamShare.AppBarLayout</item>
        <item name="toolbarStyle">@style/Widget.BeamShare.Toolbar</item>
        <item name="chipStyle">@style/Widget.BeamShare.Chip</item>
        <item name="materialCardViewStyle">@style/Widget.BeamShare.Card</item>
        <item name="bottomSheetDialogTheme">@style/Theme.BeamShare.BottomSheet</item>
        <item name="snackbarStyle">@style/Widget.BeamShare.Snackbar</item>
        <item name="switchStyle">@style/Widget.BeamShare.Switch</item>
    </style>

    <!-- Dark bottom sheet override -->
    <style name="Theme.BeamShare.BottomSheet" parent="Theme.Material3.Dark.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.BeamShare.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:colorBackground">@android:color/transparent</item>
    </style>

    <!-- Dark dialog override -->
    <style name="Theme.BeamShare.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.BeamShare.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.BeamShare.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.BeamShare.Button.Text</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BeamShare.Dialog</item>
    </style>

    <!-- Dark splash -->
    <style name="Theme.BeamShare.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/color_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.BeamShare</item>
    </style>
    <!-- Base application theme. -->
    <style name="Base.Theme.BeamShare" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>

</resources>