<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="false"
    android:paddingBottom="@dimen/_10sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ===== TOP BAR ===== -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pjs_extra_bold"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:textSize="@dimen/_22ssp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnNotifications"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/btnPremium" />

        <FrameLayout
            android:id="@+id/btnNotifications"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/bg_browse_item"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnPremium">

            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notifications"
                android:contentDescription="@null" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnPremium"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:background="@drawable/bg_premium_btn"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_premium"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- ===== HERO CARD ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/heroCard"
            android:layout_width="0dp"
            android:layout_height="@dimen/_115sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_10sdp"
            app:cardCornerRadius="@dimen/_16sdp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/btnPremium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Hero BG image — swap src in code: home_hero (green) / home_hero1 (blue) -->
            <ImageView
                android:id="@+id/ivHeroBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/home_hero"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <!-- Text overlay -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvThisDevice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/home_this_device"
                    android:textColor="#CCFFFFFF"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/pjs_medium"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:layout_marginEnd="@dimen/_120sdp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvDeviceName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="@dimen/_120sdp"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_22ssp"
                    android:fontFamily="@font/pjs_extra_bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvThisDevice" />

                <!-- DISCONNECTED: wifi pill -->
                <TextView
                    android:id="@+id/pillWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:background="@drawable/bg_hero_pill"
                    android:drawablePadding="6dp"
                    android:text="@string/home_wifi_on"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_10ssp"
                    android:fontFamily="@font/pjs_medium"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="4dp"
                    android:gravity="center_vertical"
                    android:visibility="visible"
                    app:drawableStartCompat="@drawable/ic_wifi"
                    app:drawableTint="@android:color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- CONNECTED: session timer text -->
                <TextView
                    android:id="@+id/tvSessionTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginTop="2dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="@dimen/_10ssp"
                    android:fontFamily="@font/pjs_medium"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDeviceName" />

                <!-- CONNECTED: Disconnect button -->
                <TextView
                    android:id="@+id/btnDisconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:background="@drawable/bg_disconnect_btn"
                    android:text="@string/home_disconnect"
                    android:textColor="@color/bs_dark"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/pjs_semibold"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== SEND + RECEIVE CARDS (always visible) ===== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutNotConnected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/heroCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSend"
                android:layout_width="0dp"
                android:layout_height="@dimen/_60sdp"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bs_white"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cardReceive"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginEnd="6dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/icSend"
                        android:layout_width="@dimen/_44sdp"
                        android:layout_height="@dimen/_44sdp"
                        android:src="@drawable/ic_send_home"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null"
                        android:layout_marginStart="@dimen/_12sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:text="@string/send"
                        android:textColor="@color/bs_dark"
                        android:textSize="@dimen/_12ssp"
                        android:fontFamily="@font/pjs_extra_bold"
                        app:layout_constraintStart_toEndOf="@id/icSend"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReceive"
                android:layout_width="0dp"
                android:layout_height="@dimen/_60sdp"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bs_white"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toEndOf="@id/cardSend"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="6dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/icReceive"
                        android:layout_width="@dimen/_44sdp"
                        android:layout_height="@dimen/_44sdp"
                        android:src="@drawable/ic_rec_home"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null"
                        android:layout_marginStart="@dimen/_12sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:text="@string/receive"
                        android:textColor="@color/bs_dark"
                        android:textSize="@dimen/_12ssp"
                        android:fontFamily="@font/pjs_extra_bold"
                        app:layout_constraintStart_toEndOf="@id/icReceive"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ===== ALL FILES LABEL ===== -->
        <TextView
            android:id="@+id/tvAllFilesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:text="@string/home_browse"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/_12ssp"
            android:fontFamily="@font/pjs_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutNotConnected" />

        <!-- Share Any File Row -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuickShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_8sdp"
            app:cardCornerRadius="@dimen/_14sdp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bs_white"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/tvAllFilesLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_12sdp">

                <ImageView
                    android:id="@+id/icQuickShare"
                    android:layout_width="@dimen/_38sdp"
                    android:layout_height="@dimen/_38sdp"
                    android:src="@drawable/ic_file_manager"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvShareTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:text="@string/home_share_any_file"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_12ssp"
                    android:fontFamily="@font/pjs_semibold"
                    app:layout_constraintStart_toEndOf="@id/icQuickShare"
                    app:layout_constraintEnd_toStartOf="@id/ivArrowShare"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tvShareSub" />

                <TextView
                    android:id="@+id/tvShareSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_share_sub"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/pjs_medium"
                    app:layout_constraintStart_toEndOf="@id/icQuickShare"
                    app:layout_constraintEnd_toStartOf="@id/ivArrowShare"
                    app:layout_constraintTop_toBottomOf="@id/tvShareTitle"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/ivArrowShare"
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/color_text_secondary"
                    android:contentDescription="@null"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== MORE FEATURES LABEL ===== -->
        <TextView
            android:id="@+id/tvMoreFeaturesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:text="@string/home_more_tools"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/_12ssp"
            android:fontFamily="@font/pjs_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardQuickShare" />

        <!-- Row 1: Document Scanner | Private Folder -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/featuresRow1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintTop_toBottomOf="@id/tvMoreFeaturesLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDocumentScanner"
                android:layout_width="0dp"
                android:layout_height="@dimen/_100sdp"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bs_white"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cardPrivateFolder"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginEnd="6dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_14sdp">

                    <ImageView
                        android:id="@+id/icDocScanner"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_document_scanner"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/tool_doc_scanner"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/_12ssp"
                        android:fontFamily="@font/pjs_semibold"
                        android:maxLines="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/icDocScanner" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrivateFolder"
                android:layout_width="0dp"
                android:layout_height="@dimen/_100sdp"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bs_white"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toEndOf="@id/cardDocumentScanner"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="6dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_14sdp">

                    <ImageView
                        android:id="@+id/icPrivateFolder"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_private_folder"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/tool_private_folder"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/_12ssp"
                        android:fontFamily="@font/pjs_semibold"
                        android:maxLines="2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/icPrivateFolder" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Row 2: Image Enhancer | Video to mp3 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/featuresRow2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintTop_toBottomOf="@id/featuresRow1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImageEnhancer"
                android:layout_width="0dp"
                android:layout_height="@dimen/_100sdp"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bs_white"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cardVideoToAudio"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginEnd="6dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_14sdp">

                    <ImageView
                        android:id="@+id/icImageEnhancer"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_image_enhancer"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/tool_image_enhancer"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/_12ssp"
                        android:fontFamily="@font/pjs_semibold"
                        android:maxLines="2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/icImageEnhancer" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVideoToAudio"
                android:layout_width="0dp"
                android:layout_height="@dimen/_100sdp"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/bs_white"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toEndOf="@id/cardImageEnhancer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="6dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_14sdp">

                    <ImageView
                        android:id="@+id/icVideoToAudio"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_40sdp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_mp3_converter"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/tool_video_to_audio"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/_12ssp"
                        android:fontFamily="@font/pjs_semibold"
                        android:maxLines="2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/icVideoToAudio" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Quick Share Via Link (full width) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/liveTransfersCard"
            android:layout_width="0dp"
            android:layout_height="@dimen/_70sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            app:cardCornerRadius="@dimen/_14sdp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bs_white"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/featuresRow2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/_14sdp">

                <ImageView
                    android:id="@+id/icQuickShareLink"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:src="@drawable/ic_quick_share"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvMoreTransfers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:text="@string/tool_quick_share_link"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_12ssp"
                    android:fontFamily="@font/pjs_semibold"
                    app:layout_constraintStart_toEndOf="@id/icQuickShareLink"
                    app:layout_constraintEnd_toStartOf="@id/ivArrowLink"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tvQuickShareSub" />

                <TextView
                    android:id="@+id/tvQuickShareSub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_marginTop="2dp"
                    android:text="@string/home_share_sub"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/pjs_medium"
                    app:layout_constraintStart_toEndOf="@id/icQuickShareLink"
                    app:layout_constraintEnd_toStartOf="@id/ivArrowLink"
                    app:layout_constraintTop_toBottomOf="@id/tvMoreTransfers"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/ivArrowLink"
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/color_text_secondary"
                    android:contentDescription="@null"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLiveTransfers"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>