<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/va_bg"
    tools:context=".videotoaudio.VideoToAudioFragment">

    <!-- HEADER — never scrolls -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="@dimen/_38sdp"
        android:backgroundTint="@color/color_white"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_10sdp"
        app:icon="@drawable/ic_chevron_right"
        app:iconTint="@color/va_fg2"
        app:iconGravity="textStart"
        android:scaleX="-1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvEyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="0.05"
        android:text="@string/va_eyebrow"
        android:textColor="@color/va_accent"
        android:textSize="@dimen/_15ssp"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <!-- SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/_16sdp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:fontFamily="@font/inter_bold"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/va_select_title"
                android:textColor="@color/va_fg"
                android:textSize="@dimen/_26ssp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvHeroSubtitle"
                android:layout_width="@dimen/_300sdp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:fontFamily="@font/inter"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.6"
                android:text="@string/va_select_subtitle"
                android:textColor="@color/va_fg2"
                android:textSize="@dimen/_13ssp" />

            <!-- Steps Pill -->
            <include
                android:id="@+id/stepsPill"
                layout="@layout/include_va_steps_pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_20sdp" />

            <!-- Drop Zone Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dropZone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/va_bg"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:strokeColor="@color/va_accent"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/_20sdp"
                    android:paddingEnd="@dimen/_20sdp"
                    android:paddingTop="@dimen/_24sdp"
                    android:paddingBottom="@dimen/_24sdp">

                    <!-- Upload icon card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/_56sdp"
                        android:layout_height="@dimen/_56sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        app:cardBackgroundColor="@color/va_bg"
                        app:cardCornerRadius="@dimen/_14sdp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/va_accent"
                        app:strokeWidth="@dimen/_1sdp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/_26sdp"
                            android:layout_height="@dimen/_26sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_va_upload"
                            app:tint="@color/va_accent" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_6sdp"
                        android:fontFamily="@font/inter_bold"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:text="@string/va_dz_title"
                        android:textColor="@color/va_fg"
                        android:textSize="@dimen/_15ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_14sdp"
                        android:fontFamily="@font/inter"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="1.5"
                        android:text="@string/va_dz_subtitle"
                        android:textColor="@color/va_fg2"
                        android:textSize="@dimen/_12ssp" />


                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Videos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_bold"
                        android:includeFontPadding="false"
                        android:text="@string/va_recent_title"
                        android:textColor="@color/va_fg"
                        android:textSize="@dimen/_13ssp" />

                    <TextView
                        android:id="@+id/tvSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/va_see_all"
                        android:textColor="@color/va_accent"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentVideos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_va_recent_video" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>