<?xml version="1.0" encoding="utf-8"?>
<!--
  Single permission row — NO outer CardView wrapper.
  This layout is included inside a MaterialCardView in activity_permissions_accordion.xml.
  Binding: ItemPermissionCardToggleBinding
  IDs: llRow, ivIcon, tvTitle, tvSubtitle, tvStatus
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="@dimen/_16sdp"
    android:paddingRight="@dimen/_14sdp"
    android:paddingTop="@dimen/_13sdp"
    android:paddingBottom="@dimen/_13sdp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Icon in rounded square bg -->
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:background="@drawable/bg_perm_icon_cocoon"
        android:padding="@dimen/_10sdp"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        tools:src="@drawable/ic_wifi" />

    <!-- Title + Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/_13sdp"
        android:layout_marginEnd="@dimen/_8sdp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:textColor="@color/fg_primary"
            tools:text="Nearby Wi-Fi Devices" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:textSize="@dimen/_11ssp"
            android:textColor="@color/fg_secondary"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Finds nearby devices for fast transfer" />

    </LinearLayout>

    <!-- Status chip -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/_10sdp"
        android:paddingRight="@dimen/_10sdp"
        android:paddingTop="@dimen/_4sdp"
        android:paddingBottom="@dimen/_4sdp"
        android:textSize="@dimen/_11ssp"
        android:textStyle="bold"
        android:textColor="@color/color_white"
        android:background="@drawable/bg_status_chip"
        tools:text="Required" />

</LinearLayout>