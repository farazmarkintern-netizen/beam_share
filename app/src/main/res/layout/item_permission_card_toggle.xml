<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/_10sdp"
    android:paddingHorizontal="@dimen/_2sdp">

    <!-- Colored icon circle -->
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:padding="@dimen/_9sdp"
        android:background="@drawable/bg_perm_icon_circle"
        android:contentDescription="@null" />

    <!-- Text block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/_12sdp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_14ssp"
            android:fontFamily="@font/pjs_extra_bold"
            android:textColor="@color/bs_dark" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/_11ssp"
            android:fontFamily="@font/pjs_medium"
            android:textColor="@color/bs_dark2"
            android:layout_marginTop="@dimen/_2sdp"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>

    <!-- Status chip -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_4sdp"
        android:textSize="@dimen/_11ssp"
        android:fontFamily="@font/pjs_medium"
        android:textColor="@color/bs_white"
        android:background="@drawable/bg_status_chip" />

</LinearLayout>