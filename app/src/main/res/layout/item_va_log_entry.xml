<?xml version="1.0" encoding="utf-8"?>
<!-- Process log row — item_va_log_entry -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/_5sdp"
    android:paddingBottom="@dimen/_5sdp">

    <!-- Status dot -->
    <View
        android:id="@+id/statusDot"
        android:layout_width="@dimen/_8sdp"
        android:layout_height="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="@drawable/bg_va_log_dot_done" />

    <TextView
        android:id="@+id/tvLogText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/inter"
        android:includeFontPadding="false"
        android:textColor="@color/va_fg"
        android:textSize="@dimen/_12ssp"
        tools:text="Demuxing audio stream" />

    <TextView
        android:id="@+id/tvLogTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:includeFontPadding="false"
        android:textColor="@color/va_fg2"
        android:textSize="@dimen/_11ssp"
        tools:text="0.3s" />
</LinearLayout>
