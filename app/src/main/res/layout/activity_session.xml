<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_16sdp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_centerVertical="true"
            android:contentDescription="@string/back"
            android:src="@drawable/back_press"
          />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_toEndOf="@id/btnBack"
            android:fontFamily="@font/pjs_semibold"
            android:text="@string/session_home_title"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/_16ssp" />

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/color_text_primary" />
    </RelativeLayout>

    <!-- Incoming transfer banner (GONE by default) -->
    <LinearLayout
        android:id="@+id/incomingBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_12sdp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_icon_circle_blue" />

            <ImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_download"
                app:tint="@android:color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBannerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/pjs_semibold"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:id="@+id/tvBannerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pjs_regular"
                android:textColor="#FFFFFFCC"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBannerProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pjs_bold"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_16ssp" />
    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_10sdp">


            <!-- Connected badge -->
            <LinearLayout
                android:id="@+id/connectionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/bg_badge_connected"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_4sdp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="@dimen/_6sdp"
                    android:layout_height="@dimen/_6sdp"
                    android:background="@drawable/bg_dot_green" />

                <TextView
                    android:id="@+id/tvConnectedDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:fontFamily="@font/pjs_medium"
                    android:text="@string/connected"
                    android:textColor="@color/bs_green"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <!-- Action Cards — hero image style -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:orientation="vertical">

                <!-- Send Files card -->
                <FrameLayout
                    android:id="@+id/btnSendFiles"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_90sdp"
                    android:background="@drawable/bg_hero_card"
                    android:clipToOutline="true"
                    android:outlineProvider="background"
                    android:layout_marginBottom="@dimen/_10sdp"
                    >

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/send_hero_card" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pjs_bold"
                            android:text="@string/session_send_files"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_16ssp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:fontFamily="@font/pjs_regular"
                            android:text="@string/session_share_desc"
                            android:textColor="#FFFFFFCC"
                            android:textSize="@dimen/_11ssp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Leave Session card -->
                <FrameLayout
                    android:id="@+id/btnEndSession"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_90sdp"
                    android:background="@drawable/bg_hero_card"
                    android:clipToOutline="true"
                    android:outlineProvider="background">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/leave_hero_card" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pjs_bold"
                            android:text="@string/session_leave"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_16ssp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:fontFamily="@font/pjs_regular"
                            android:text="@string/session_end_desc"
                            android:textColor="#FFFFFFCC"
                            android:textSize="@dimen/_11ssp" />
                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>

            <!-- Stats Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="3">

                <!-- Sent Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:background="@drawable/bg_stat_card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/_8sdp">

                    <FrameLayout
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                     >

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_total_send" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatSent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pjs_bold"
                            android:text="0"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_16ssp"
                            android:maxLines="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pjs_regular"
                            android:text="@string/session_stat_sent"
                            android:textColor="@color/color_text_tertiary"
                            android:textSize="@dimen/_11ssp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Received Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:background="@drawable/bg_stat_card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/_8sdp">

                    <FrameLayout
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                       >

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:contentDescription="@null"
                            android:src="@drawable/ic_total_received" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatReceived"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pjs_bold"
                            android:text="0"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_16ssp"
                            android:maxLines="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pjs_regular"
                            android:text="@string/receive"
                            android:textColor="@color/color_text_tertiary"
                            android:textSize="@dimen/_11ssp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Total Card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:background="@drawable/bg_stat_card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/_8sdp">

                    <FrameLayout
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                     >

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_total" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pjs_bold"
                            android:text="0 MB"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_14ssp"
                            android:maxLines="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pjs_regular"
                            android:text="@string/session_stat_total"
                            android:textColor="@color/color_text_tertiary"
                            android:textSize="@dimen/_11ssp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
            <!-- THIS SESSION label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:fontFamily="@font/pjs_semibold"
                android:letterSpacing="0.05"
                android:text="@string/session_this_session"
                android:textAllCaps="true"
                android:textColor="@color/color_text_tertiary"
                android:textSize="@dimen/_11ssp" />

            <!-- File list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSessionFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="@dimen/_24sdp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>