<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:paddingLeft="@dimen/_20sdp"
    android:paddingRight="@dimen/_20sdp"
    android:paddingTop="@dimen/_24sdp"
    android:paddingBottom="@dimen/_16sdp">

    <!-- Icon circle -->
    <FrameLayout
        android:layout_width="@dimen/_48sdp"
        android:layout_height="@dimen/_48sdp"
        android:layout_gravity="start">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_dialog_icon_blue" />

        <ImageView
            android:id="@+id/ivDialogIcon"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_file_outline"
            app:tint="@color/color_primary" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:fontFamily="@font/inter_bold"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/_15ssp"
        android:text="File Name.mp4" />

    <!-- Details row: size · device -->
    <TextView
        android:id="@+id/tvDialogDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:fontFamily="@font/inter"
        android:textColor="@color/color_text_secondary"
        android:textSize="@dimen/_12ssp"
        android:text="24.3 MB · Received from Adnan's Phone" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/_20sdp"
        android:background="@color/color_divider" />

    <!-- Action: Open file -->
    <LinearLayout
        android:id="@+id/optionOpenFile"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <FrameLayout
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_option_icon_blue" />
            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_open_file"
                app:tint="@color/color_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"
            android:text="@string/dialog_open_file"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/_13ssp" />

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/color_text_secondary" />
    </LinearLayout>

    <!-- Action: Show in folder -->
    <LinearLayout
        android:id="@+id/optionShowInFolder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <FrameLayout
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_option_icon_purple" />
            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_folder"
                app:tint="#7C3AED" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"
            android:text="@string/dialog_show_in_folder"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/_13ssp" />

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/color_text_secondary" />
    </LinearLayout>

    <!-- Action: Delete from history -->
    <LinearLayout
        android:id="@+id/optionDelete"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <FrameLayout
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_option_icon_red" />
            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_delete"
                app:tint="#EF4444" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"
            android:text="@string/dialog_delete_history"
            android:textColor="#EF4444"
            android:textSize="@dimen/_13ssp" />

        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="#EF4444" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/_4sdp"
        android:background="@color/color_divider" />

    <!-- Cancel button -->
    <TextView
        android:id="@+id/btnDialogCancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:gravity="center"
        android:fontFamily="@font/inter_medium"
        android:text="@string/cancel"
        android:textColor="@color/color_text_secondary"
        android:textSize="@dimen/_13ssp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>
