<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_main.xml -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- NavHost Fragment -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavBar" />

    <!-- ====== CUSTOM BOTTOM NAVIGATION BAR ====== -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_56sdp"
        android:background="@drawable/bg_bottom_nav_bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Home Tab -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="@dimen/_6sdp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginBottom="@dimen/_2sdp">

                <!-- Active Indicator Pill -->
                <View
                    android:id="@+id/indicatorHome"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_indicator"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/iconHome"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    app:tint="@color/color_primary"
                    android:contentDescription="@string/nav_home" />
            </FrameLayout>

            <TextView
                android:id="@+id/labelHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/_10ssp"
                android:fontFamily="@font/inter_medium" />
        </LinearLayout>

        <!-- Transfers Tab -->
        <LinearLayout
            android:id="@+id/navTransfers"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="@dimen/_6sdp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginBottom="@dimen/_2sdp">

                <View
                    android:id="@+id/indicatorTransfers"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_indicator"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/iconTransfers"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/color_text_tertiary"
                    android:contentDescription="@string/nav_transfers" />
            </FrameLayout>

            <TextView
                android:id="@+id/labelTransfers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_transfers"
                android:textColor="@color/color_text_tertiary"
                android:textSize="@dimen/_10ssp"
                android:fontFamily="@font/inter_medium" />
        </LinearLayout>

        <!-- Settings Tab -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="@dimen/_6sdp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginBottom="@dimen/_2sdp">

                <View
                    android:id="@+id/indicatorSettings"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_indicator"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/iconSettings"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/color_text_tertiary"
                    android:contentDescription="@string/nav_settings" />
            </FrameLayout>

            <TextView
                android:id="@+id/labelSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_settings"
                android:textColor="@color/color_text_tertiary"
                android:textSize="@dimen/_10ssp"
                android:fontFamily="@font/inter_medium" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>