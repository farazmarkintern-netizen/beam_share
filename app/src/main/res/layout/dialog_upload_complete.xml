<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="24dp">

    <!-- Success Icon Circle -->
    <FrameLayout
        android:id="@+id/layoutSuccessIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_upload_complete_circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check_bold"
            android:contentDescription="@null"
            app:tint="@color/bs_white" />

    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvCompleteTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cloud_upload_complete_title"
        android:textSize="18sp"
        android:fontFamily="@font/pjs_bold"
        android:textColor="@color/bs_dark"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSuccessIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvCompleteSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cloud_upload_complete_desc"
        android:textSize="13sp"
        android:fontFamily="@font/pjs_regular"
        android:textColor="@color/bs_gray"
        android:textAlignment="center"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvCompleteTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Done Button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDoneBtn"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="25dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/tvCompleteSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/btn_next_gradient">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cloud_done"
                android:textSize="15sp"
                android:fontFamily="@font/pjs_semibold"
                android:textColor="@color/bs_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
