<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/va_bg"
    >

    <!-- HEADER — never scrolls -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:scaleX="-1"
        android:backgroundTint="@color/color_white"

        app:icon="@drawable/ic_chevron_right"
        app:iconTint="@color/va_fg2"
        app:iconGravity="textStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvEyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="0.05"
        android:text="@string/va_format_title"
        android:textColor="@color/va_accent"
        android:textSize="@dimen/_15ssp"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <!-- SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toTopOf="@id/footer">

        <LinearLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/_20sdp"
            android:paddingEnd="@dimen/_20sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingBottom="@dimen/_10sdp">

            <!-- Steps pill -->
            <include
                android:id="@+id/stepsPill"
                layout="@layout/include_va_steps_pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_20sdp" />

            <!-- Selected file card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_20sdp"
                app:cardBackgroundColor="@color/va_surface"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_14sdp">

                    <!-- Video icon card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        android:layout_marginEnd="@dimen/_14sdp"
                        app:cardBackgroundColor="@color/va_accent"

                        app:cardCornerRadius="@dimen/_12sdp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/_22sdp"
                            android:layout_height="@dimen/_22sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_video"
                            app:tint="@android:color/white" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSelectedFileName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/inter_bold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/va_fg"
                            android:textSize="@dimen/_14ssp"
                            tools:text="vacation_2024.mp4" />

                        <TextView
                            android:id="@+id/tvSelectedFileMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:fontFamily="@font/inter"
                            android:includeFontPadding="false"
                            android:textColor="@color/va_fg2"
                            android:textSize="@dimen/_11ssp"
                            tools:text="234 MB · MP4 · 1080p · 18:02" />
                    </LinearLayout>

                    <!-- Check badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/_28sdp"
                        android:layout_height="@dimen/_28sdp"
                        app:cardBackgroundColor="@color/va_bg"
                        app:cardCornerRadius="@dimen/_14sdp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/_14sdp"
                            android:layout_height="@dimen/_14sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_check_bold"
                            app:tint="@color/va_green" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Output format label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_14sdp"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/va_section_format"
                android:textAllCaps="true"
                android:textColor="@color/va_fg2"
                android:textSize="@dimen/_11ssp" />

            <!-- MP3 info card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_20sdp"
                app:cardBackgroundColor="@color/va_surface"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_14sdp">

                    <!-- Icon card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/_38sdp"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_marginEnd="@dimen/_12sdp"
                        app:cardBackgroundColor="@color/va_accent"

                        app:cardCornerRadius="@dimen/_10sdp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_18sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_music"
                            app:tint="@color/color_white" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:includeFontPadding="false"
                            android:text="@string/va_format_mp3_title"
                            android:textColor="@color/va_fg"
                            android:textSize="@dimen/_13ssp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:fontFamily="@font/inter"
                            android:includeFontPadding="false"
                            android:lineSpacingMultiplier="1.5"
                            android:text="@string/va_format_mp3_desc"
                            android:textColor="@color/va_fg2"
                            android:textSize="@dimen/_12ssp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: Bitrate label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_14sdp"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:text="@string/va_section_bitrate"
                android:textAllCaps="true"
                android:textColor="@color/va_fg2"
                android:textSize="@dimen/_11ssp" />

            <!-- Bitrate chip group -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/bitrateChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_20sdp"
                app:chipSpacingHorizontal="@dimen/_8sdp"
                app:chipSpacingVertical="@dimen/_8sdp"
                app:selectionRequired="true"
                app:singleLine="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip64"
                    style="@style/Widget.BeamShare.Chip.VaBitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/va_bitrate_64" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip128"
                    style="@style/Widget.BeamShare.Chip.VaBitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/va_bitrate_128" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip192"
                    style="@style/Widget.BeamShare.Chip.VaBitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/va_bitrate_192" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip256"
                    style="@style/Widget.BeamShare.Chip.VaBitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/va_bitrate_256" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip320"
                    style="@style/Widget.BeamShare.Chip.VaBitrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/va_bitrate_320" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Estimated size card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/va_surface"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_14sdp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/va_est_size_label"
                            android:textColor="@color/va_fg2"
                            android:textSize="@dimen/_12ssp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:alpha="0.7"
                            android:fontFamily="@font/inter"
                            android:includeFontPadding="false"
                            android:text="@string/va_est_size_note"
                            android:textColor="@color/va_fg2"
                            android:textSize="@dimen/_11ssp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEstSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:includeFontPadding="false"
                        android:text="@string/va_est_size_default"
                        android:textColor="@color/va_fg"
                        android:textSize="@dimen/_22ssp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- STICKY FOOTER -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/va_surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnStartConverting"
            style="@style/Widget.BeamShare.Button.VaPrimary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:text="@string/va_btn_start_converting" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>