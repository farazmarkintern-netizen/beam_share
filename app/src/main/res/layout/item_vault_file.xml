<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5sdp"
    app:cardCornerRadius="@dimen/_12sdp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/color_card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_12sdp">

        <!-- File icon area with colored background -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_72sdp"
            android:layout_marginBottom="@dimen/_8sdp">

            <View
                android:id="@+id/viewIconBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_vault_file_icon" />

            <ImageView
                android:id="@+id/ivFileIcon"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_document"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- File name -->
        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/_11ssp"
            android:fontFamily="@font/inter_semibold"
            android:text="filename.pdf" />

        <!-- File size + 3-dot menu row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvFileSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1.2 MB"
                android:textColor="@color/color_text_tertiary"
                android:textSize="@dimen/_10ssp"
                android:fontFamily="@font/inter_regular" />

            <ImageView
                android:id="@+id/ivMore"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:src="@drawable/ic_more_vertical"
                android:padding="4dp"
                app:tint="@color/color_text_tertiary"
                android:contentDescription="More options"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>