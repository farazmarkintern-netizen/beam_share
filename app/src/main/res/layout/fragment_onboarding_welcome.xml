<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/fragment_onboarding_welcome.xml -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- ====== ILLUSTRATION AREA (Dark Blue Top Section) ====== -->
    <FrameLayout
        android:id="@+id/illustrationContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/color_splash"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomCard">

        <!-- Place your exported PNG illustration here -->
        <!-- Name your PNG: res/drawable/img_onboarding_share.png -->
        <ImageView
            android:id="@+id/ivIllustration"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_onboarding_share"
            android:scaleType="centerInside"
            android:contentDescription="@string/onboarding_welcome_title" />

    </FrameLayout>

    <!-- ====== BOTTOM WHITE CARD SECTION ====== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_bottom_card"
        android:paddingHorizontal="@dimen/_24sdp"
        android:paddingTop="@dimen/_30sdp"
        android:paddingBottom="@dimen/_24sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.42">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_welcome_title"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/_22ssp"
            android:fontFamily="@font/inter_bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:text="@string/onboarding_welcome_desc"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/_13ssp"
            android:fontFamily="@font/inter"
            android:textAlignment="center"
            android:lineSpacingExtra="@dimen/_3sdp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Next Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_45sdp"
            android:text="@string/onboarding_next"
            android:textColor="@color/color_white"
            android:textSize="@dimen/_14ssp"
            android:fontFamily="@font/inter_semibold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/color_primary"
            app:cornerRadius="@dimen/_12sdp"
            app:layout_constraintBottom_toTopOf="@id/tvSkip"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="@dimen/_10sdp" />

        <!-- Skip Text -->
        <TextView
            android:id="@+id/tvSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_skip"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/_13ssp"
            android:fontFamily="@font/inter"
            android:paddingVertical="@dimen/_6sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>