<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_16sdp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_centerVertical="true"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/color_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_toEndOf="@id/btnBack"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/connect"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/_16ssp" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:tint="@color/color_text_primary" />
    </RelativeLayout>

    <!-- Tab Buttons: Scan QR | Enter Code -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_16sdp">

        <TextView
            android:id="@+id/tabScanQR"
            android:layout_width="0dp"
            android:layout_height="@dimen/_36sdp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/_4sdp"
            android:background="@drawable/bg_tab_selected"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="@string/scan_qr"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_13ssp" />

        <TextView
            android:id="@+id/tabEnterCode"
            android:layout_width="0dp"
            android:layout_height="@dimen/_36sdp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_4sdp"
            android:background="@drawable/bg_tab_unselected"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:text="@string/enter_code"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/_13ssp" />
    </LinearLayout>

    <!-- QR Scanner View Container -->
    <FrameLayout
        android:id="@+id/scannerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Camera Preview -->
        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1A1A2E" />

        <!-- Viewfinder Frame -->
        <FrameLayout
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_200sdp"
            android:layout_gravity="center">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_viewfinder_corner" />
        </FrameLayout>

        <!-- Scan instruction text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/_24sdp"
            android:fontFamily="@font/inter_medium"
            android:text="@string/point_camera_at_qr"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_13ssp" />
    </FrameLayout>

    <!-- Bottom Section: Nearby Devices -->
    <LinearLayout
        android:id="@+id/bottomSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_background"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_16sdp"
        android:paddingBottom="@dimen/_8sdp">

        <!-- Section Header: NEARBY + Searching -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.05"
                android:text="@string/connect_nearby_label"
                android:textAllCaps="true"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/_11ssp" />

            <TextView
                android:id="@+id/tvSearchingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="@string/connect_searching"
                android:textColor="#16A34A"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>

        <!-- Nearby Devices List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNearbyDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false" />

        <!-- Searching state -->
        <LinearLayout
            android:id="@+id/searchingState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_16sdp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:indeterminateTint="@color/color_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:fontFamily="@font/inter"
                android:text="@string/searching_for_devices"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Enter Code Section (hidden by default) -->
    <LinearLayout
        android:id="@+id/enterCodeSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top content area (centered above keypad) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_32sdp">

            <!-- Normal state header -->
            <LinearLayout
                android:id="@+id/enterCodeNormalHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/_48sdp"
                    android:layout_height="@dimen/_48sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_keyboard"
                    app:tint="@color/color_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/enter_pairing_code"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_18ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:text="@string/connect_code_subtitle"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/_13ssp" />
            </LinearLayout>

            <!-- Error state header (GONE by default) -->
            <LinearLayout
                android:id="@+id/enterCodeErrorHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Warning icon in circle -->
                <FrameLayout
                    android:layout_width="@dimen/_48sdp"
                    android:layout_height="@dimen/_48sdp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_warning_circle" />

                    <ImageView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_warning_triangle"
                        app:tint="#EF4444" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="@string/connect_code_error_title"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_18ssp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:text="@string/connect_code_error_subtitle"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/_13ssp" />
            </LinearLayout>

            <!-- 6-digit code input boxes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24sdp"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etCode1"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:background="@drawable/bg_code_input"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:maxLength="1"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_18ssp" />

                <EditText
                    android:id="@+id/etCode2"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:background="@drawable/bg_code_input"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:maxLength="1"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_18ssp" />

                <EditText
                    android:id="@+id/etCode3"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:background="@drawable/bg_code_input"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:maxLength="1"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_18ssp" />

                <EditText
                    android:id="@+id/etCode4"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:background="@drawable/bg_code_input"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:maxLength="1"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_18ssp" />

                <EditText
                    android:id="@+id/etCode5"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:background="@drawable/bg_code_input"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:maxLength="1"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_18ssp" />

                <EditText
                    android:id="@+id/etCode6"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_48sdp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:background="@drawable/bg_code_input"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:maxLength="1"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_18ssp" />
            </LinearLayout>

            <!-- Error text row (GONE) -->
            <LinearLayout
                android:id="@+id/codeErrorRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning_triangle"
                    app:tint="#EF4444" />

                <TextView
                    android:id="@+id/tvCodeError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:fontFamily="@font/inter"
                    android:textColor="#EF4444"
                    android:textSize="@dimen/_12ssp" />
            </LinearLayout>

            <!-- Connect button -->
            <TextView
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_46sdp"
                android:layout_marginTop="@dimen/_24sdp"
                android:background="@drawable/bg_connect_button"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="@string/connect"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_15ssp" />

            <!-- Try Again button (GONE, shown in error state) -->
            <TextView
                android:id="@+id/btnTryAgain"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_46sdp"
                android:layout_marginTop="@dimen/_24sdp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="@string/connect_try_again"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_15ssp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Custom Number Keypad -->
        <LinearLayout
            android:id="@+id/numpadContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_surface"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_16sdp">

            <!-- Row 1: 1 2 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/key1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_20ssp" />

                <TextView
                    android:id="@+id/key2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_20ssp" />

                <TextView
                    android:id="@+id/key3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_20ssp" />
            </LinearLayout>

            <!-- Row 2: 4 5 6 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/key4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_20ssp" />

                <TextView
                    android:id="@+id/key5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_20ssp" />

                <TextView
                    android:id="@+id/key6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="6"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_20ssp" />
            </LinearLayout>

            <!-- Row 3: 7 8 9 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/key7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="7"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_20ssp" />

                <TextView
                    android:id="@+id/key8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="8"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_20ssp" />

                <TextView
                    android:id="@+id/key9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="9"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_20ssp" />
            </LinearLayout>

            <!-- Row 4: (empty) 0 (backspace) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/key0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_20ssp" />

                <ImageView
                    android:id="@+id/keyBackspace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:padding="@dimen/_12sdp"
                    android:src="@drawable/ic_backspace"
                    app:tint="@color/color_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>