<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/va_bg"
    tools:context=".videotoaudio.ConvertingFragment">

    <!-- HEADER -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:scaleX="-1"
        android:backgroundTint="@color/color_white"
        app:icon="@drawable/ic_chevron_right"
        app:iconTint="@color/va_fg2"
        app:iconGravity="textStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="0.05"
        android:text="@string/va_converting_title"
        android:textColor="@color/va_accent"
        android:textSize="@dimen/_15ssp"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <!-- SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_20sdp"
            android:paddingEnd="@dimen/_20sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingBottom="@dimen/_24sdp">

            <!-- STEPS PILL -->
            <include
                android:id="@+id/stepsPill"
                layout="@layout/include_va_steps_pill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_28sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- HERO GLOW -->
            <View
                android:id="@+id/heroGlow"
                android:layout_width="@dimen/_200sdp"
                android:layout_height="@dimen/_200sdp"
                android:background="@drawable/bg_va_hero_glow_blue"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/stepsPill" />

            <!-- CIRCULAR PROGRESS -->
            <com.example.beamshare.videotoaudio.CircularProgressView
                android:id="@+id/circularProgress"
                android:layout_width="@dimen/_140sdp"
                android:layout_height="@dimen/_140sdp"
                app:cpv_progress="70"
                app:cpv_progressColor="@color/va_accent"
                app:cpv_strokeWidth="@dimen/_8sdp"
                app:cpv_trackColor="@color/va_surface2"
                app:layout_constraintBottom_toBottomOf="@id/heroGlow"
                app:layout_constraintEnd_toEndOf="@id/heroGlow"
                app:layout_constraintStart_toStartOf="@id/heroGlow"
                app:layout_constraintTop_toTopOf="@id/heroGlow" />

            <!-- PERCENTAGE -->
            <TextView
                android:id="@+id/tvPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_2sdp"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:text="@string/va_progress_percent_default"
                android:textColor="@color/va_fg"
                android:textSize="@dimen/_28ssp"
                app:layout_constraintBottom_toTopOf="@id/tvProgressLabel"
                app:layout_constraintEnd_toEndOf="@id/circularProgress"
                app:layout_constraintStart_toStartOf="@id/circularProgress"
                app:layout_constraintTop_toTopOf="@id/circularProgress"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:includeFontPadding="false"
                android:text="@string/va_progress_label"
                android:textColor="@color/va_fg2"
                android:textSize="@dimen/_11ssp"
                app:layout_constraintBottom_toBottomOf="@id/circularProgress"
                app:layout_constraintEnd_toEndOf="@id/circularProgress"
                app:layout_constraintStart_toStartOf="@id/circularProgress"
                app:layout_constraintTop_toBottomOf="@id/tvPercent" />

            <!-- STATUS TITLE -->
            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_28sdp"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/va_status_encoding"
                android:textColor="@color/va_fg"
                android:textSize="@dimen/_18ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/heroGlow" />

            <!-- STATUS SUBTITLE -->
            <TextView
                android:id="@+id/tvStatusSub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/va_status_sub"
                android:textColor="@color/va_fg2"
                android:textSize="@dimen/_13ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvStatusTitle" />

            <!-- LINEAR PROGRESS -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/linearProgress"
                android:layout_width="0dp"
                android:layout_height="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:progress="70"
                app:indicatorColor="@color/va_accent"
                app:trackColor="@color/va_surface2"
                app:trackCornerRadius="@dimen/_3sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvStatusSub" />

            <!-- STATS ROW: ELAPSED + SPEED ONLY -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardElapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                app:cardBackgroundColor="@color/va_surface"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toStartOf="@id/cardSpeed"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linearProgress">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:id="@+id/tvElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:includeFontPadding="false"
                        android:text="@string/va_stat_elapsed_default"
                        android:textColor="@color/va_fg"
                        android:textSize="@dimen/_16ssp" />

                    <TextView
                        android:id="@+id/tvElapsedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/inter"
                        android:includeFontPadding="false"
                        android:text="@string/va_stat_elapsed_label"
                        android:textColor="@color/va_fg2"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                app:cardBackgroundColor="@color/va_surface"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/cardElapsed"
                app:layout_constraintTop_toTopOf="@id/cardElapsed">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:includeFontPadding="false"
                        android:text="@string/va_stat_speed_default"
                        android:textColor="@color/va_fg"
                        android:textSize="@dimen/_16ssp" />

                    <TextView
                        android:id="@+id/tvSpeedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/inter"
                        android:includeFontPadding="false"
                        android:text="@string/va_stat_speed_label"
                        android:textColor="@color/va_fg2"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- STICKY FOOTER -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/va_surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/_20sdp"
        android:paddingEnd="@dimen/_20sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnCancel"
            style="@style/Widget.BeamShare.Button.VaSecondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:text="@string/va_btn_cancel" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
