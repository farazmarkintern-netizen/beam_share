<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <!-- Close Button -->
    <ImageButton
        android:id="@+id/btnCloseDialog"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/close"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/bs_gray" />

    <!-- Cloud Icon -->
    <ImageView
        android:id="@+id/imgCloudIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_cloud_storage"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnCloseDialog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cloud_title"
        android:textSize="18sp"
        android:fontFamily="@font/pjs_bold"
        android:textColor="@color/bs_dark"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/imgCloudIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvDialogDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cloud_permission_desc"
        android:textSize="13sp"
        android:fontFamily="@font/pjs_regular"
        android:textColor="@color/bs_gray"
        android:textAlignment="center"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvDialogTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Agree & Continue Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAgree"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="@string/cloud_agree_btn"
        android:textSize="15sp"
        android:fontFamily="@font/pjs_semibold"
        android:textColor="@color/bs_white"
        android:layout_marginTop="24dp"
        android:background="@drawable/btn_next_gradient"

        app:cornerRadius="25dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvDialogDesc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Privacy Policy text -->
    <TextView
        android:id="@+id/tvPrivacyPolicy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cloud_privacy_note"
        android:textSize="11sp"
        android:fontFamily="@font/pjs_regular"
        android:textColor="@color/bs_gray"
        android:textAlignment="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnAgree"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
