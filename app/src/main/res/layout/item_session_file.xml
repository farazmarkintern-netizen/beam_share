<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_card"
    android:layout_marginBottom="@dimen/_8sdp"
    android:orientation="vertical"
    android:padding="@dimen/_12sdp">

    <!-- Row 1: icon + name/size + direction badge + cancel/status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- File type icon -->
        <FrameLayout
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_icon_circle_blue" />

            <ImageView
                android:id="@+id/ivFileIcon"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_folder"
                app:tint="#2563EB" />
        </FrameLayout>

        <!-- Name + size -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/_13ssp"
                tools:text="vacation_video_4k.mp4" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Direction badge: SENT / RECEIVED -->
                <TextView
                    android:id="@+id/tvDirection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_2sdp"
                    android:textSize="@dimen/_9ssp"
                    tools:background="@drawable/bg_badge_live"
                    tools:text="SENT"
                    tools:textColor="#2563EB" />

                <TextView
                    android:id="@+id/tvFileSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/color_text_tertiary"
                    android:textSize="@dimen/_11ssp"
                    tools:text="128 MB" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right side: cancel button (active) OR status icon (done/failed) -->
        <FrameLayout
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp">

            <!-- Cancel button — shown only while ACTIVE -->
            <ImageView
                android:id="@+id/btnCancel"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cancel"
                android:src="@drawable/ic_error_circle"
                android:visibility="gone"
                app:tint="#DC2626"
                tools:visibility="visible" />

            <!-- Status icon — shown when COMPLETED or FAILED -->
            <ImageView
                android:id="@+id/ivStatus"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle_filled"
                android:visibility="gone"
                app:tint="#16A34A"
                tools:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Row 2: progress bar + percentage — hidden when not ACTIVE -->
    <LinearLayout
        android:id="@+id/layoutProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="@dimen/_6sdp"
            android:layout_weight="1"
            android:max="100"
            android:progress="45"
            android:progressTint="#2563EB"
            android:progressBackgroundTint="#E2E8F0" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:fontFamily="@font/inter_semibold"
            android:gravity="end"
            android:textColor="#2563EB"
            android:textSize="@dimen/_11ssp"
            tools:text="45%" />
    </LinearLayout>

</LinearLayout>
