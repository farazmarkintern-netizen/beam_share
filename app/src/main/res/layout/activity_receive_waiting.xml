<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_48sdp"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_16sdp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_centerVertical="true"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/color_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_toEndOf="@id/btnBack"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/receive_screen_title"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/_16ssp" />

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/color_text_primary" />
    </RelativeLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_24sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_16sdp">

            <!-- Instruction Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="@string/receive_instruction"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/_13ssp" />

            <!-- QR Code Container -->
            <FrameLayout
                android:layout_width="@dimen/_200sdp"
                android:layout_height="@dimen/_200sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@drawable/bg_qr_container"
                android:padding="@dimen/_16sdp">

                <ImageView
                    android:id="@+id/ivQRCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/qr_code"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qr_code_placeholder" />
            </FrameLayout>

            <!-- Pairing Code Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:fontFamily="@font/inter"
                android:letterSpacing="0.05"
                android:text="@string/pairing_code"
                android:textAllCaps="true"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/_11ssp" />

            <!-- Pairing Code -->
            <TextView
                android:id="@+id/tvPairingCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:fontFamily="@font/inter_bold"
                android:letterSpacing="0.15"
                android:text="000 000"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/_28ssp" />

            <!-- Device Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_24sdp"
                android:background="@drawable/bg_surface_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_12sdp">

                <!-- Phone icon -->
                <FrameLayout
                    android:layout_width="@dimen/_36sdp"
                    android:layout_height="@dimen/_36sdp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_icon_circle_blue" />

                    <ImageView
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_phone_device"
                        app:tint="#2563EB" />
                </FrameLayout>

                <!-- Device name + subtitle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDeviceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/_14ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:fontFamily="@font/inter"
                        android:text="@string/receive_visible_as"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Waiting Status -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/pulsingDot"
                    android:layout_width="@dimen/_8sdp"
                    android:layout_height="@dimen/_8sdp"
                    android:background="@drawable/bg_pulsing_dot_orange" />

                <TextView
                    android:id="@+id/tvWaitingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:fontFamily="@font/inter_medium"
                    android:text="@string/waiting_for_sender"
                    android:textColor="#F59E0B"
                    android:textSize="@dimen/_13ssp" />
            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Stop Receiving Button -->
            <TextView
                android:id="@+id/btnStopReceiving"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginTop="@dimen/_24sdp"
                android:background="@drawable/bg_button_outlined"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="@string/stop_receiving"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/_14ssp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>