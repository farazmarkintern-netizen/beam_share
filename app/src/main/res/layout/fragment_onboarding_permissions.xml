<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/fragment_onboarding_permissions.xml -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:paddingHorizontal="@dimen/_20sdp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_50sdp"
        android:text="@string/onboarding_permissions_title"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/_22ssp"
        android:fontFamily="@font/inter_bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:text="@string/onboarding_permissions_subtitle"
        android:textColor="@color/color_text_secondary"
        android:textSize="@dimen/_12ssp"
        android:fontFamily="@font/inter"
        android:lineSpacingExtra="@dimen/_2sdp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Permission List -->
    <ScrollView
        android:id="@+id/scrollPermissions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_20sdp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnAllow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Nearby Wi-Fi Devices -->
            <include
                android:id="@+id/permWifi"
                layout="@layout/item_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_4sdp" />

            <!-- 2. Bluetooth -->
            <include
                android:id="@+id/permBluetooth"
                layout="@layout/item_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_4sdp" />

            <!-- 3. Files & Storage -->
            <include
                android:id="@+id/permStorage"
                layout="@layout/item_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_4sdp" />

            <!-- 4. Camera -->
            <include
                android:id="@+id/permCamera"
                layout="@layout/item_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_4sdp" />

            <!-- 5. Contacts -->
            <include
                android:id="@+id/permContacts"
                layout="@layout/item_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_4sdp" />

            <!-- 6. Notifications -->
            <include
                android:id="@+id/permNotifications"
                layout="@layout/item_permission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

    <!-- Allow Permissions Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAllow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_45sdp"
        android:layout_marginBottom="@dimen/_30sdp"
        android:text="@string/onboarding_allow_permissions"
        android:textColor="@color/color_white"
        android:textSize="@dimen/_14ssp"
        android:fontFamily="@font/inter_semibold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/color_primary"
        app:cornerRadius="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>