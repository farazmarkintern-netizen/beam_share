<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <!-- App Icon -->
    <ImageView
        android:id="@+id/imgPermissionIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_media_permission"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvPermissionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/permission_title"
        android:textSize="17sp"
        android:fontFamily="@font/pjs_bold"
        android:textColor="@color/bs_dark"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/imgPermissionIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvPermissionDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/permission_media_desc"
        android:textSize="13sp"
        android:fontFamily="@font/pjs_regular"
        android:textColor="@color/bs_gray"
        android:textAlignment="center"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvPermissionTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#1A000000"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvPermissionDesc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cancel Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPermissionCancel"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:text="@string/permission_cancel"
        android:textSize="14sp"
        android:fontFamily="@font/pjs_semibold"
        android:textColor="@color/bs_gray"
        android:background="@drawable/bg_btn_cancel_outline"
        android:stateListAnimator="@null"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPermissionAllow" />
    <!-- Allow Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPermissionAllow"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/btn_next_gradient"
        android:text="@string/permission_allow"
        android:textSize="14sp"
        android:fontFamily="@font/pjs_semibold"
        android:textColor="@color/bs_white"
        android:stateListAnimator="@null"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toEndOf="@id/btnPermissionCancel"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
