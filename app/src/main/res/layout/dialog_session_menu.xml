<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:paddingTop="@dimen/_20sdp"
    android:paddingBottom="@dimen/_12sdp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:fontFamily="@font/inter_semibold"
        android:letterSpacing="0.05"
        android:text="@string/session_options"
        android:textAllCaps="true"
        android:textColor="@color/color_text_tertiary"
        android:textSize="@dimen/_11ssp" />

    <!-- Rename this device -->
    <LinearLayout
        android:id="@+id/menuRename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_14sdp">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_edit_pencil"
            app:tint="@color/color_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRenameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="@string/session_rename_device"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/_14ssp" />

            <TextView
                android:id="@+id/tvCurrentDeviceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:fontFamily="@font/inter"
                android:textColor="@color/color_text_tertiary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Open received folder -->
    <LinearLayout
        android:id="@+id/menuOpenFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_14sdp">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_folder"
            app:tint="@color/color_text_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOpenFolderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:text="@string/session_open_folder"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/_14ssp" />

            <TextView
                android:id="@+id/tvFolderPath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:fontFamily="@font/inter"
                android:textColor="@color/color_text_tertiary"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Auto-accept files toggle -->
    <LinearLayout
        android:id="@+id/menuAutoAccept"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingVertical="@dimen/_14sdp">

        <ImageView
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_bold"
            app:tint="@color/color_text_secondary" />

        <TextView
            android:id="@+id/tvAutoAcceptTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_weight="1"
            android:fontFamily="@font/inter_medium"
            android:text="@string/session_auto_accept"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/_14ssp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAutoAccept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>


</LinearLayout>