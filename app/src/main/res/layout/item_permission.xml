<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_permission.xml -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/_10sdp">

    <!-- Permission Icon Circle -->
    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:background="@drawable/bg_permission_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivPermissionIcon"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_gravity="center"
            app:tint="@color/color_primary"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Permission Name -->
    <TextView
        android:id="@+id/tvPermissionName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/_13ssp"
        android:fontFamily="@font/inter_semibold"
        app:layout_constraintStart_toEndOf="@id/iconContainer"
        app:layout_constraintEnd_toStartOf="@id/tvBadge"
        app:layout_constraintTop_toTopOf="@id/iconContainer"
        app:layout_constraintBottom_toTopOf="@id/tvPermissionDesc"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Permission Description -->
    <TextView
        android:id="@+id/tvPermissionDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_1sdp"
        android:textColor="@color/color_text_tertiary"
        android:textSize="@dimen/_10ssp"
        android:fontFamily="@font/inter"
        app:layout_constraintStart_toEndOf="@id/iconContainer"
        app:layout_constraintEnd_toStartOf="@id/tvBadge"
        app:layout_constraintTop_toBottomOf="@id/tvPermissionName"
        app:layout_constraintBottom_toBottomOf="@id/iconContainer" />

    <!-- Required / Optional Badge -->
    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_3sdp"
        android:textSize="@dimen/_9ssp"
        android:fontFamily="@font/inter_medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>