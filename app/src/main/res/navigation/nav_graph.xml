<?xml version="1.0" encoding="utf-8"?>
<!-- res/navigation/nav_graph.xml -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.beamshare.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" >

        <action
            android:id="@+id/action_home_to_cloudStorage"
            app:destination="@id/cloudStorageFragment" />
    </fragment>

    <fragment
        android:id="@+id/transfersFragment"
        android:name="com.example.beamshare.ui.transfers.TransfersFragment"
        android:label="Transfers"
        tools:layout="@layout/fragment_transfers" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.beamshare.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <!-- VA01 — entry point -->
    <fragment
        android:id="@+id/videoToAudioFragment"
        android:name="com.example.beamshare.videotoaudio.VideoToAudioFragment"
        android:label="Video to Audio"
        tools:layout="@layout/fragment_va01_select_video">

        <action
            android:id="@+id/action_videoToAudioFragment_to_formatQualityFragment"
            app:destination="@id/formatQualityFragment" />
    </fragment>

    <!-- VA02 -->
    <fragment
        android:id="@+id/formatQualityFragment"
        android:name="com.example.beamshare.videotoaudio.FormatQualityFragment"
        android:label="Format &amp; Quality"
        tools:layout="@layout/fragment_va02_format_quality">

        <action
            android:id="@+id/action_formatQualityFragment_to_convertingFragment"
            app:destination="@id/convertingFragment" />
    </fragment>

    <!-- VA03 -->
    <fragment
        android:id="@+id/convertingFragment"
        android:name="com.example.beamshare.videotoaudio.ConvertingFragment"
        android:label="Converting"
        tools:layout="@layout/fragment_va03_converting">

        <action
            android:id="@+id/action_convertingFragment_to_doneFragment"
            app:destination="@id/doneFragment" />
    </fragment>

    <!-- VA04 -->
    <fragment
        android:id="@+id/doneFragment"
        android:name="com.example.beamshare.videotoaudio.DoneFragment"
        android:label="Done"
        tools:layout="@layout/fragment_va04_done">

        <action
            android:id="@+id/action_doneFragment_to_videoToAudioFragment"
            app:destination="@id/videoToAudioFragment"
            app:popUpTo="@id/videoToAudioFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/receivedFilesFragment"
        android:name="com.example.beamshare.ui.home.ReceivedFilesFragment"
        android:label="Received Files"
        tools:layout="@layout/fragment_received_files" />

    <!-- Document Scanner — directly to PreviewSave (no crop screen) -->
    <fragment
        android:id="@+id/documentScannerFragment"
        android:name="com.example.beamshare.documentscanner.DocumentScannerFragment"
        android:label="Document Scanner"
        tools:layout="@layout/fragment_document_scanner">

        <action
            android:id="@+id/action_documentScannerFragment_to_previewSaveFragment"
            app:destination="@id/previewSaveFragment" />
    </fragment>

    <fragment
        android:id="@+id/previewSaveFragment"
        android:name="com.example.beamshare.documentscanner.PreviewSaveFragment"
        android:label="Preview"
        tools:layout="@layout/fragment_preview_save">

        <argument
            android:name="imageUri"
            app:argType="string"
            android:defaultValue="" />

    </fragment>







    <!-- Cloud Storage -->
    <fragment
        android:id="@+id/cloudStorageFragment"
        android:name="com.example.beamshare.cloud.CloudStorageFragment"
        android:label="Cloud Storage"
        tools:layout="@layout/fragment_cloud_storage">

        <action
            android:id="@+id/action_cloudStorageFragment_to_cloudLoginFragment"
            app:destination="@id/cloudLoginFragment" />

        <action
            android:id="@+id/action_cloudStorageFragment_to_cloudUploadingFragment"
            app:destination="@id/cloudUploadingFragment" />

        <action
            android:id="@+id/action_cloudStorageFragment_to_cloudDirectoryFragment"
            app:destination="@id/cloudDirectoryFragment" />
    </fragment>

    <!-- Cloud Directory -->
    <fragment
        android:id="@+id/cloudDirectoryFragment"
        android:name="com.example.beamshare.cloud.CloudDirectoryFragment"
        android:label="Cloud Directory"
        tools:layout="@layout/fragment_cloud_directory">

        <action
            android:id="@+id/action_cloudDirectoryFragment_to_cloudLoginFragment"
            app:destination="@id/cloudLoginFragment" />

        <action
            android:id="@+id/action_cloudDirectoryFragment_to_cloudStorageFragment"
            app:destination="@id/cloudStorageFragment" />
    </fragment>

    <fragment
        android:id="@+id/cloudUploadingFragment"
        android:name="com.example.beamshare.cloud.CloudUploadingFragment"
        android:label="Uploading"
        tools:layout="@layout/fragment_cloud_uploading">

        <argument
            android:name="fileUri"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/cloudLoginFragment"
        android:name="com.example.beamshare.cloud.CloudLoginFragment"
        android:label="Cloud Login"
        tools:layout="@layout/fragment_cloud_login">

        <action
            android:id="@+id/action_cloudLoginFragment_to_cloudUploadingFragment"
            app:destination="@id/cloudUploadingFragment" />
    </fragment>
</navigation>